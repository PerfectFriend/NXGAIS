{
  "name": "react-example",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerfectFriend/NeXXus-Node.git"
  },
  "bugs": {
    "url": "https://github.com/PerfectFriend/NeXXus-Node/issues"
  },
  "homepage": "https://github.com/PerfectFriend/NeXXus-Node#readme",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx test/protocol.test.ts && tsx test/golden-vectors.test.ts",
    "test:vectors": "tsx test/golden-vectors.test.ts",
    "rust:test": "cargo test --workspace",
    "rust:build": "cargo build --release -p nexxusd",
    "rust:daemon": "cargo run -p nexxusd -- serve",
    "rust:benchmark": "cargo run -p nexxusd -- benchmark",
    "rust:por": "cargo run -p nexxusd -- por-challenge",
    "vectors:gen": "tsx scripts/generate-golden-vectors.ts",
    "linux:daemon": "cargo run -p nexxusd -- serve",
    "linux:benchmark": "cargo run -p nexxusd -- benchmark",
    "linux:test-por": "cargo run -p nexxusd -- por-challenge",
    "linux:status": "cargo run -p nexxusd -- status",
    "linux:install": "bash scripts/install-ubuntu.sh",
    "deb:build": "bash scripts/build-deb.sh",
    "build:packages": "bash scripts/build-deb.sh && bash scripts/build-rpm.sh && bash scripts/build-windows-pkg.sh",
    "build:rpm": "bash scripts/build-rpm.sh",
    "build:win": "bash scripts/build-windows-pkg.sh",
    "bundle:daemon": "esbuild scripts/linux-daemon.ts --bundle --platform=node --format=cjs --outfile=dist/nexxusd.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
